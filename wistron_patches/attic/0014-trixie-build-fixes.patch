diff --git a/dockers/docker-platform-monitor/Dockerfile.j2 b/dockers/docker-platform-monitor/Dockerfile.j2
index e64611551..7b26693ee 100755
--- a/dockers/docker-platform-monitor/Dockerfile.j2
+++ b/dockers/docker-platform-monitor/Dockerfile.j2
@@ -46,8 +46,10 @@ RUN apt-get install -y -t bookworm-backports \
 # doesn't ensure all dependencies are installed in the container. So here we
 # install any dependencies required by the Arista sonic_platform package.
 # TODO: eliminate the need to install these explicitly.
-RUN pip3 install grpcio==1.51.1 \
-        grpcio-tools==1.51.1
+# Skipped for the marvell-prestera build: grpcio is only needed by the Arista
+# sonic_platform package (not used by Marvell PMon daemons), and grpcio==1.51.1
+# is unbuildable here (no arm64 wheel on the mirror; the sdist setup.py imports
+# pkg_resources which newer setuptools >=81 dropped).
 
 # Barefoot platform vendors' sonic_platform packages import these Python libraries (and netifaces)
 RUN pip3 install thrift==0.13.0
diff --git a/files/build_templates/sonic_debian_extension.j2 b/files/build_templates/sonic_debian_extension.j2
index baca66b3c..c65b968df 100644
--- a/files/build_templates/sonic_debian_extension.j2
+++ b/files/build_templates/sonic_debian_extension.j2
@@ -235,6 +235,17 @@ sudo LANG=C DEBIAN_FRONTEND=noninteractive chroot $FILESYSTEM_ROOT apt-get -y in
 # install libffi-dev to match utilities' dependency.
 sudo LANG=C DEBIAN_FRONTEND=noninteractive chroot $FILESYSTEM_ROOT apt-get -y install libffi-dev
 
+# trixie pip 25.x hard-errors trying to uninstall RECORD-less apt python3-* packages
+# (uninstall-no-record-file) when the sonic-utilities wheel pulls newer versions.
+# Pre-install the pure-Python ones via pip (--ignore-installed creates a pip RECORD)
+# so the wheel install can manage them. Scoped to these packages, so SONiC inter-wheel
+# deps (sonic-py-common, ...) still resolve. Compiled pkgs (cryptography/cffi/...) stay apt.
+sudo https_proxy=$https_proxy LANG=C chroot $FILESYSTEM_ROOT pip3 install --ignore-installed regex click natsort enlighten
+# bcrypt/paramiko/scp also have RECORD-less apt versions the wheel upgrades; use
+# --no-deps so we only re-record these (not their compiled deps cryptography/pynacl,
+# which the wheel doesn't upgrade and which stay as the apt-provided versions).
+sudo https_proxy=$https_proxy LANG=C chroot $FILESYSTEM_ROOT pip3 install --ignore-installed --no-deps bcrypt paramiko scp
+
 # Install SONiC Utilities Python package
 install_pip_package {{sonic_utilities_py3_wheel_path}}
 
