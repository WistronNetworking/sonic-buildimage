diff --git a/rules/makedumpfile.mk b/rules/makedumpfile.mk
new file mode 100644
index 000000000..7adbf4f29
--- /dev/null
+++ b/rules/makedumpfile.mk
@@ -0,0 +1,15 @@
+# makedumpfile package
+MAKEDUMPFILE_VERSION = 1.7.9
+MAKEDUMPFILE_VERSION_FULL = $(MAKEDUMPFILE_VERSION)-0~sonic1
+export MAKEDUMPFILE_VERSION
+export MAKEDUMPFILE_VERSION_FULL
+
+MAKEDUMPFILE = makedumpfile_$(MAKEDUMPFILE_VERSION_FULL)_$(CONFIGURED_ARCH).deb
+$(MAKEDUMPFILE)_SRC_PATH = $(SRC_PATH)/makedumpfile
+SONIC_MAKE_DEBS += $(MAKEDUMPFILE)
+
+MAKEDUMPFILE_DBG = makedumpfile-dbgsym_$(MAKEDUMPFILE_VERSION_FULL)_$(CONFIGURED_ARCH).deb
+$(eval $(call add_derived_package,$(MAKEDUMPFILE),$(MAKEDUMPFILE_DBG)))
+
+export MAKEDUMPFILE
+export MAKEDUMPFILE_DBG
