diff --git a/src/makedumpfile/debian/rules b/src/makedumpfile/debian/rules
new file mode 100755
index 000000000..50394ef23
--- /dev/null
+++ b/src/makedumpfile/debian/rules
@@ -0,0 +1,36 @@
+#!/usr/bin/make -f
+
+export DH_VERBOSE = 1
+
+%:
+	dh $@
+
+override_dh_auto_build:
+	$(MAKE) \
+		LINKTYPE=dynamic \
+		USELZO=on \
+		USESNAPPY=off \
+		USEZSTD=on
+
+override_dh_auto_install:
+	install -D -m 755 makedumpfile \
+		$(CURDIR)/debian/makedumpfile/usr/bin/makedumpfile
+	install -D -m 755 makedumpfile-R.pl \
+		$(CURDIR)/debian/makedumpfile/usr/bin/makedumpfile-R.pl
+	install -D -m 644 makedumpfile.conf \
+		$(CURDIR)/debian/makedumpfile/usr/share/makedumpfile/makedumpfile.conf.sample
+	[ -f makedumpfile.8.in ] && \
+		sed "s/@VERSION@/$(MAKEDUMPFILE_VERSION)/g" makedumpfile.8.in \
+		> makedumpfile.8 || true
+	[ -f makedumpfile.conf.5.in ] && \
+		sed "s/@VERSION@/$(MAKEDUMPFILE_VERSION)/g" makedumpfile.conf.5.in \
+		> makedumpfile.conf.5 || true
+	[ -f makedumpfile.8 ] && \
+		install -D -m 644 makedumpfile.8 \
+		$(CURDIR)/debian/makedumpfile/usr/share/man/man8/makedumpfile.8 || true
+	[ -f makedumpfile.conf.5 ] && \
+		install -D -m 644 makedumpfile.conf.5 \
+		$(CURDIR)/debian/makedumpfile/usr/share/man/man5/makedumpfile.conf.5 || true
+
+override_dh_auto_test:
+	# Skip tests
