diff --git a/src/makedumpfile/Makefile b/src/makedumpfile/Makefile
new file mode 100644
index 000000000..ddd6cf985
--- /dev/null
+++ b/src/makedumpfile/Makefile
@@ -0,0 +1,38 @@
+.ONESHELL:
+SHELL = /bin/bash
+.SHELLFLAGS += -e
+
+MAIN_TARGET = $(MAKEDUMPFILE)
+DERIVED_TARGETS = $(MAKEDUMPFILE_DBG)
+
+$(addprefix $(DEST)/, $(MAIN_TARGET)): $(DEST)/% :
+	# Remove any stale files from previous builds
+	rm -rf ./makedumpfile-build
+	rm -f makedumpfile_*.deb makedumpfile-dbgsym_*.deb makedumpfile_*.buildinfo makedumpfile_*.changes
+
+	# Clone latest makedumpfile source from upstream
+	git clone https://github.com/makedumpfile/makedumpfile.git makedumpfile-build
+	pushd ./makedumpfile-build
+
+	# Copy debian packaging structure into source tree
+	cp -r ../debian ./debian
+
+	# Build debian package
+ifeq ($(CROSS_BUILD_ENVIRON), y)
+	dpkg-buildpackage -rfakeroot -d -b -us -uc \
+		-a$(CONFIGURED_ARCH) \
+		-Pcross,nocheck \
+		-j$(SONIC_CONFIG_MAKE_JOBS) \
+		--admindir $(SONIC_DPKG_ADMINDIR)
+else
+	dpkg-buildpackage -rfakeroot -d -b -us -uc \
+		-j$(SONIC_CONFIG_MAKE_JOBS) \
+		--admindir $(SONIC_DPKG_ADMINDIR)
+endif
+
+	popd
+
+	# Move the newly-built .deb packages to the destination directory
+	mv $(DERIVED_TARGETS) $* $(DEST)/
+
+$(addprefix $(DEST)/, $(DERIVED_TARGETS)): $(DEST)/% : $(DEST)/$(MAIN_TARGET)
