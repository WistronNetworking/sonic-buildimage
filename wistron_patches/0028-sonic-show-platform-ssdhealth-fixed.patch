+    def _run_mmc_extcsd(self):
+        """
+        Run 'mmc extcsd read <diskdev>' and return the output string.
+        Returns None if the command fails or times out.
+        """
+        try:
+            devpath = os.path.join('/dev', os.path.basename(self.diskdev))
+            result = subprocess.run(
+                ['mmc', 'extcsd', 'read', devpath],
+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                timeout=30
+            )
+            if result.returncode == 0:
+                return result.stdout.decode('utf-8', errors='replace')
+        except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
+            pass
+        return None
 
+    def _parse_extcsd_field(self, output, field_name):
+        """
+        Parse a hex value from 'mmc extcsd' output for the given field name.
+        Example line: "EXT_CSD_DEVICE_LIFE_TIME_EST_TYP_B [DEVICE_LIFE_TIME_EST_TYP_B]: 0x02"
+        Returns the integer value, or None if not found / unparseable.
+        """
+        if output is None:
+            return None
+        for line in output.splitlines():
+            if field_name in line and ':' in line:
+                hex_str = line.split(':')[-1].strip()
+                try:
+                    return int(hex_str, 0)
+                except (ValueError, TypeError):
+                    pass
+        return None
+
+    def _is_slc(self):
+        _EINVAL_ = (1 << 64) - 22  # 18446744073709551594
+        offset_str = self._read_device_entry('enhanced_area_offset')
+        try:
+            offset = int(offset_str)
+        except (ValueError, TypeError):
+            return False
+        return offset != _EINVAL_ and offset > 0
