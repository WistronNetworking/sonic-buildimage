diff --git a/src/sonic-utilities/tests/conftest.py b/src/sonic-utilities/tests/conftest.py
index c1fd82a7..bba241cc 100644
--- a/src/sonic-utilities/tests/conftest.py
+++ b/src/sonic-utilities/tests/conftest.py
@@ -2,6 +2,31 @@ import json
 import os
 import re
 import sys
+
+# Python 3.12 removed the stdlib 'imp' module, but several tests on the trixie
+# slave (Python 3.13) still do `import imp` / `imp.reload` / `imp.load_source`.
+# Register a minimal shim before test modules are collected.
+if 'imp' not in sys.modules:
+    import types as _types
+    import importlib as _importlib
+    import importlib.util as _ilu
+    import importlib.machinery as _ilm
+    _imp = _types.ModuleType('imp')
+    _imp.reload = _importlib.reload
+
+    def _imp_load_source(name, pathname, file=None):
+        # Use an explicit SourceFileLoader so extensionless scripts (e.g.
+        # scripts/null_route_helper) load like the old imp.load_source did.
+        loader = _ilm.SourceFileLoader(name, pathname)
+        spec = _ilu.spec_from_file_location(name, pathname, loader=loader)
+        module = _ilu.module_from_spec(spec)
+        sys.modules[name] = module
+        loader.exec_module(module)
+        return module
+
+    _imp.load_source = _imp_load_source
+    sys.modules['imp'] = _imp
+
 from unittest import mock
 
 import pytest
