+# -*- coding: utf-8 -*-
+"""
+SONiC / CPSS: static FDB for the switch MAC on a given VLAN, then add the CPU
+logical port (fixed 63) as a tagged VLAN member.
+
+VLAN ID is required on the command line. CPU port is always 63.
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+from telnetlib import Telnet
+
+# CPU / logical port for FDB egress and VLAN member (fixed)
+CPU_PORT = 63
+
+DEV_NUM = 0
+CPSS_HOST = "localhost"
+CPSS_PORT = 12345
+TELNET_TIMEOUT = 30
+READ_TIMEOUT = 5
+
+
+def get_device_mac():
+    """Lowercase MAC from DEVICE_METADATA.localhost.mac."""
+    result = subprocess.run(
+        ["sonic-cfggen", "-d", "-v", "DEVICE_METADATA.localhost.mac"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    mac = result.stdout.strip().lower()
+    if not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
+        raise ValueError("Unexpected MAC format: {!r}".format(mac))
+    return mac
+
+
+def validate_vlan_id(vid):
+    v = int(vid)
+    if v < 1 or v > 4094:
+        raise ValueError("VLAN ID must be 1..4094, got {}".format(v))
+    return v
+
+
+class CpssTelnet(object):
+    def __init__(self, host=CPSS_HOST, port=CPSS_PORT, timeout=TELNET_TIMEOUT):
+        self.tn = Telnet(host, port, timeout)
+
+    def close(self):
+        try:
+            self.tn.write(b"CLIexit\n")
+        except Exception:
+            pass
+        try:
+            self.tn.close()
+        except Exception:
+            pass
+
+    def add_static_mac_entry(self, mac, vlan_id, dev_num=DEV_NUM):
+        """
+        cpssDxChBrgFdbMacEntrySet: interactive sequence aligned with add_macentry.py.
+        Egress port is CPU_PORT (63).
+        """
+        self.tn.write(
+            ("do cpss-api call cpssDxChBrgFdbMacEntrySet devNum {}\n".format(dev_num)).encode()
+        )
+        self.tn.read_until(b"entryType", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vid1", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"key", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_ENTRY_EXT_KEY_MAC_VLAN_STC\n")
+        self.tn.read_until(b"macAddr", READ_TIMEOUT)
+        self.tn.write(mac.encode() + b"\n")
+        self.tn.read_until(b"vlanId", READ_TIMEOUT)
+        self.tn.write(str(vlan_id).encode() + b"\n")
+        self.tn.read_until(b"type", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"\\", READ_TIMEOUT)
+        self.tn.write(b"16\n")
+        self.tn.read_until(b"portNum", READ_TIMEOUT)
+        self.tn.write(str(CPU_PORT).encode() + b"\n")
+        self.tn.read_until(b"trunkId", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vidx", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vlanId", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"devNum", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"fabricVidx", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"index", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"age", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"isStatic", READ_TIMEOUT)
+        self.tn.write(b"true\n")
+        self.tn.read_until(b"daCommand", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_TABLE_CNTL_E\n")
+        self.tn.read_until(b"saCommand", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_TABLE_SOFT_DROP_E\n")
+        self.tn.read_until(b"daRoute", READ_TIMEOUT)
+        self.tn.write(b"*\n")
+
+    def add_cpu_port_to_vlan(
+        self,
+        vlan_id,
+        dev_num=DEV_NUM,
+        is_tagged=True,
+        port_tag_cmd="CPSS_DXCH_BRG_VLAN_PORT_TAG0_CMD_E",
+    ):
+        """
+        cpssDxChBrgVlanMemberAdd: one line (non-interactive). Port fixed to CPU_PORT.
+        """
+        line = (
+            "do cpss-api call cpssDxChBrgVlanMemberAdd "
+            "devNum {d} vlanId {v} portNum {p} isTagged {t} portTaggingCmd {c}\n"
+        ).format(
+            d=dev_num,
+            v=vlan_id,
+            p=CPU_PORT,
+            t="true" if is_tagged else "false",
+            c=port_tag_cmd,
+        )
+        self.tn.write(line.encode())
+
+
+def run(vlan_id, host, cpss_port, dev_num=DEV_NUM):
+    mac = get_device_mac()
+    vlan_id = validate_vlan_id(vlan_id)
+
+    print("Device MAC: {}".format(mac))
+    print("VLAN: {}, CPU port (fixed): {}, devNum: {}".format(vlan_id, CPU_PORT, dev_num))
+
+    cpss = CpssTelnet(host=host, port=cpss_port)
+    try:
+        print("Adding static MAC entry...")
+        cpss.add_static_mac_entry(mac=mac, vlan_id=vlan_id, dev_num=dev_num)
+
+        print("Adding VLAN member (CPU port {}, tagged)...".format(CPU_PORT))
+        cpss.add_cpu_port_to_vlan(vlan_id=vlan_id, dev_num=dev_num)
+
+        print("Done.")
+    finally:
+        cpss.close()
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        description=(
+            "Static FDB for device MAC on the given VLAN + add CPU port {} "
+            "as VLAN member (CPSS). VLAN ID is required."
+        ).format(CPU_PORT)
+    )
+    parser.add_argument(
+        "vlan_id",
+        type=int,
+        help="VLAN ID (1..4094). Example: 951",
+    )
+    parser.add_argument(
+        "--dev",
+        type=int,
+        default=DEV_NUM,
+        help="CPSS devNum (default: {}).".format(DEV_NUM),
+    )
+    parser.add_argument(
+        "--host",
+        default=CPSS_HOST,
+        help="CPSS telnet host (default: {}).".format(CPSS_HOST),
+    )
+    parser.add_argument(
+        "--cpss-port",
+        type=int,
+        default=CPSS_PORT,
+        metavar="PORT",
+        help="CPSS telnet port (default: {}).".format(CPSS_PORT),
+    )
+    args = parser.parse_args(argv)
+
+    try:
+        run(
+            vlan_id=args.vlan_id,
+            host=args.host,
+            cpss_port=args.cpss_port,
+            dev_num=args.dev,
+        )
+    except Exception as e:
+        print("{}: {}".format(type(e).__name__, e), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
