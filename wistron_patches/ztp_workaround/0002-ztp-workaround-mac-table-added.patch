+# -*- coding: utf-8 -*-
+"""
+SONiC / CPSS helper: fixed VLAN 951 only.
+
+1) Static FDB: device MAC -> VLAN 951, egress port 63 .
+2) VLAN member: one-line cpssDxChBrgVlanMemberAdd for VLAN 951, port 63, tagged.
+
+Edit VLAN_ID / PORT_NUM / CPSS_HOST / CPSS_PORT at the top if needed.
+"""
+
+import os
+import re
+import subprocess
+import sys
+
