+CPSS_PORT = 12345
+TELNET_TIMEOUT = 30
+READ_TIMEOUT = 5
+
+
+def get_device_mac():
+    """Return lowercase MAC from SONiC config DB."""
+    result = subprocess.run(
+        ["sonic-cfggen", "-d", "-v", "DEVICE_METADATA.localhost.mac"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    mac = result.stdout.strip().lower()
+    if not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
+        raise ValueError("Unexpected MAC format: {!r}".format(mac))
+    return mac
+
