+hook_dhcp_for_vlans() {
+    if [ "$HOOK_ALL_VLANS" = true ]; then
+        for vlan in $(ip link show | grep -o 'Vlan[0-9]*' | sort -u); do
+            echo "Checking status of $vlan"
+            if ip link show "$vlan" | grep -q "state UP"; then
+                # Get the member ports directly from the VLAN configuration
+                vlan_info=$(show vlan brief | grep "$vlan")
+                echo "VLAN info: $vlan_info"  # Log the VLAN info for debugging
+
+                # Extract member ports
+                member_ports=$(show vlan config | awk -v v="$vlan" '$1 == v { print $3 }')
+                echo "Extracted member ports: $member_ports"  # Log the extracted member ports
+
+                # Check if member ports are empty
+                if [ -z "$member_ports" ]; then
+                    echo "No member ports found for $vlan."
+                    continue
+                fi
+
+                # Check each member port status using show interface status
+                found_up_member=false
+                for member_port in $member_ports; do
+                    member_oper=$(show interface status | awk -v p="$member_port" '$1 == p { print $8; exit }')
+                    echo "Member port: $member_port, Oper: $member_oper"
+
+                    if [ "$member_oper" = "up" ]; then
+                        echo "Found UP member port: $member_port"
+                        found_up_member=true
+                        break  # No need to check further if one is UP
+                    fi
+                done
+
+                if $found_up_member; then
+                    echo "Starting DHCP client on $vlan"
+                    dhclient -v "$vlan" &
+                else
+                    echo "Skipping $vlan: No member ports are up."
+                fi
+            else
+                echo "Skipping $vlan: Interface is down."
+            fi
+        done
