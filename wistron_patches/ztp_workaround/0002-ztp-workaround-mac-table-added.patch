+    cpss = CpssTelnet()
+    try:
+        print("Adding static MAC entry (VLAN {})...".format(VLAN_ID))
+        cpss.add_static_mac_entry(mac=mac, vlan_id=VLAN_ID, port_num=PORT_NUM)
+
+        print("Adding VLAN {} member (port {}, tagged)...".format(VLAN_ID, PORT_NUM))
+        cpss.add_vlan_member(vlan_id=VLAN_ID, port_num=PORT_NUM)
+
+        print("Done.")
+    finally:
+        cpss.close()
+
+
+if __name__ == "__main__":
+    main()
