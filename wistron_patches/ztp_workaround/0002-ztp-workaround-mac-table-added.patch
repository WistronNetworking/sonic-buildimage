+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+"""
+Read VLAN IDs from kernel interfaces (ip link show), then for each VLAN:
+  1) Add static FDB (device MAC -> that VLAN, egress CPU port 63).
+  2) Add CPU port 63 as tagged VLAN member (cpssDxChBrgVlanMemberAdd).
+
+Requires: ip, sonic-cfggen, CPSS telnet on localhost:12345 (override with --host/--cpss-port).
+"""
+
+import argparse
+import re
+import subprocess
+import sys
+from typing import List
+
+from telnetlib import Telnet
+
+CPU_PORT = 63
+DEV_NUM = 0
+CPSS_HOST = "localhost"
+CPSS_PORT = 12345
+TELNET_TIMEOUT = 30
+READ_TIMEOUT = 5
+
+
+def get_device_mac():
+    result = subprocess.run(
+        ["sonic-cfggen", "-d", "-v", "DEVICE_METADATA.localhost.mac"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    mac = result.stdout.strip().lower()
+    if not re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac):
+        raise ValueError("Unexpected MAC format: {!r}".format(mac))
+    return mac
+
+
+def load_vlan_ids() -> List[int]:
+    result = subprocess.run(
+        ["ip", "link", "show"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    vlan_ids = {int(m) for m in re.findall(r"Vlan(\d+)", result.stdout)}
+    return sorted(vlan_ids)
+
+
+class CpssTelnet(object):
+    def __init__(self, host=CPSS_HOST, port=CPSS_PORT, timeout=TELNET_TIMEOUT):
+        self.tn = Telnet(host, port, timeout)
+
+    def close(self):
+        try:
+            self.tn.write(b"CLIexit\n")
+        except Exception:
+            pass
+        try:
+            self.tn.close()
+        except Exception:
+            pass
+
+    def add_static_mac_entry(self, mac, vlan_id, dev_num=DEV_NUM):
+        """
+        cpssDxChBrgFdbMacEntrySet - same interactive sequence as add_macentry.py.
+        CPU egress port fixed to CPU_PORT (63).
+        """
+        self.tn.write(
+            ("do cpss-api call cpssDxChBrgFdbMacEntrySet devNum {}\n".format(dev_num)).encode()
+        )
+        self.tn.read_until(b"entryType", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vid1", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"key", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_ENTRY_EXT_KEY_MAC_VLAN_STC\n")
+        self.tn.read_until(b"macAddr", READ_TIMEOUT)
+        self.tn.write(mac.encode() + b"\n")
+        self.tn.read_until(b"vlanId", READ_TIMEOUT)
+        self.tn.write(str(vlan_id).encode() + b"\n")
+        self.tn.read_until(b"type", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"\\", READ_TIMEOUT)
+        self.tn.write(b"16\n")
+        self.tn.read_until(b"portNum", READ_TIMEOUT)
+        self.tn.write(str(CPU_PORT).encode() + b"\n")
+        self.tn.read_until(b"trunkId", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vidx", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"vlanId", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"devNum", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"fabricVidx", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"index", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"age", READ_TIMEOUT)
+        self.tn.write(b"\n")
+        self.tn.read_until(b"isStatic", READ_TIMEOUT)
+        self.tn.write(b"true\n")
+        self.tn.read_until(b"daCommand", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_TABLE_CNTL_E\n")
+        self.tn.read_until(b"saCommand", READ_TIMEOUT)
+        self.tn.write(b"CPSS_MAC_TABLE_SOFT_DROP_E\n")
+        self.tn.read_until(b"daRoute", READ_TIMEOUT)
+        self.tn.write(b"*\n")
+
+    def add_cpu_port_vlan_member(
+        self,
+        vlan_id,
+        dev_num=DEV_NUM,
+        is_tagged=True,
+        port_tag_cmd="CPSS_DXCH_BRG_VLAN_PORT_TAG0_CMD_E",
+    ):
+        """cpssDxChBrgVlanMemberAdd - single line (non-interactive), port fixed 63."""
+        line = (
+            "do cpss-api call cpssDxChBrgVlanMemberAdd "
+            "devNum {d} vlanId {v} portNum {p} isTagged {t} portTaggingCmd {c}\n"
+        ).format(
+            d=dev_num,
+            v=vlan_id,
+            p=CPU_PORT,
+            t="true" if is_tagged else "false",
+            c=port_tag_cmd,
+        )
+        self.tn.write(line.encode())
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(
+        description=(
+            "From ip link show (Vlan* interfaces): for each VLAN add static FDB "
+            "(device MAC) and CPU port {} as VLAN member."
+        ).format(CPU_PORT)
+    )
+    parser.add_argument(
+        "--host",
+        default=CPSS_HOST,
+        help="CPSS telnet host (default: {}).".format(CPSS_HOST),
+    )
+    parser.add_argument(
+        "--cpss-port",
+        type=int,
+        default=CPSS_PORT,
+        metavar="PORT",
+        help="CPSS telnet port (default: {}).".format(CPSS_PORT),
+    )
+    parser.add_argument(
+        "--dev",
+        type=int,
+        default=DEV_NUM,
+        help="CPSS devNum (default: {}).".format(DEV_NUM),
+    )
+    parser.add_argument(
+        "--dry-run",
+        action="store_true",
+        help="Only print VLAN IDs from ip link; no CPSS changes.",
+    )
+    args = parser.parse_args(argv)
+
+    try:
+        vlan_ids = load_vlan_ids()
+    except Exception as e:
+        print("{}: {}".format(type(e).__name__, e), file=sys.stderr)
+        return 1
+
+    mac = get_device_mac()
+    print("Device MAC: {}".format(mac))
+    print("CPU port (fixed): {}".format(CPU_PORT))
+    print("VLANs from ip link: {}".format(vlan_ids))
+
+    if not vlan_ids:
+        print("No VLAN IDs found.", file=sys.stderr)
+        return 1
+
+    if args.dry_run:
+        print("Dry-run: no CPSS changes.")
+        return 0
+
+    cpss = CpssTelnet(host=args.host, port=args.cpss_port)
+    try:
+        for vid in vlan_ids:
+            print("--- VLAN {} ---".format(vid))
+            print("Adding static MAC entry...")
+            cpss.add_static_mac_entry(mac=mac, vlan_id=vid, dev_num=args.dev)
+            print("Adding VLAN member (CPU port {}, tagged)...".format(CPU_PORT))
+            cpss.add_cpu_port_vlan_member(vlan_id=vid, dev_num=args.dev)
+        print("Done.")
+    except Exception as e:
+        print("{}: {}".format(type(e).__name__, e), file=sys.stderr)
+        return 1
+    finally:
+        cpss.close()
+
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
