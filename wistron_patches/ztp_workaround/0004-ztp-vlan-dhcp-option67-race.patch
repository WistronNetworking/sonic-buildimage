+        if [[ -n "${current_pid}" ]]; then
+            current_starttime=$(vlan_dhclient_starttime "${current_pid}" 2>/dev/null || true)
+        fi
+
+        if [[ "${current_pid}" == "${owned_pid}" && \
+              "${current_starttime}" == "${owned_starttime}" && \
+              -n "${owned_pid}" ]]; then
+            echo "Stopping DHCP client on ${vlan} (pid ${owned_pid})"
+            kill "${owned_pid}" 2>/dev/null || true
+
+            for ((retry = 0; retry < 20; retry++)); do
+                kill -0 "${owned_pid}" 2>/dev/null || break
+                sleep 0.1
+            done
+
+            if kill -0 "${owned_pid}" 2>/dev/null; then
+                echo "Failed to stop DHCP client on ${vlan} (pid ${owned_pid})"
+                stop_failed=true
+                continue
+            fi
+        fi
+
+        # Do not remove a PID file that may now belong to another dhclient.
+        if [[ -s "${pid_file}" && "$(<"${pid_file}")" == "${owned_pid}" ]]; then
+            rm -f "${pid_file}"
+        fi
+        rm -f "${marker_file}"
+    done
+
+    [[ "${stop_failed}" == false ]]
+}
