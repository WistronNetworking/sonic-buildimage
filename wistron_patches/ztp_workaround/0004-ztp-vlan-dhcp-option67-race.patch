+    set_candidate_value "${candidate_path}/graph-url" "${new_minigraph_url:-}"
+    set_candidate_value "${candidate_path}/acl-url" "${new_acl_url:-}"
+    set_candidate_value "${candidate_path}/dhcp-server" "$candidate_server"
+    set_candidate_value "${candidate_path}/router" "$candidate_router"
+
+    if ! candidate_has_data "$candidate_path"; then
+        rm -rf "$candidate_path"
+        return 1
+    fi
