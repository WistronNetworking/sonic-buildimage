+#!/bin/sh
+
+# A relayed DHCP server identifier can be outside the client subnet. Ensure
+# renewals and ZTP downloads use the router learned on the same VLAN before the
+# later "ztp" exit hook publishes DHCP Option 67 to ztp-engine.
+ztp_vlan_route_lease_usable() {
+    [ "${reason:-}" != "TIMEOUT" ] && return 0
+    [ -n "${new_ip_address:-}" ] || return 1
+
+    ip -4 -o addr show dev "${interface}" 2>/dev/null | \
+        grep -Fq " ${new_ip_address}/"
+}
+
+ztp_vlan_route_delete() {
+    ztp_vlan_route_old_server=${old_dhcp_server_identifier:-}
+    ztp_vlan_route_old_server=${ztp_vlan_route_old_server%% *}
+    ztp_vlan_route_old_gateway=${old_routers:-}
+    ztp_vlan_route_old_gateway=${ztp_vlan_route_old_gateway%% *}
+
+    if [ -n "${ztp_vlan_route_old_server}" ] && \
+       [ -n "${ztp_vlan_route_old_gateway}" ]; then
+        ip route del "${ztp_vlan_route_old_server}/32" \
+            via "${ztp_vlan_route_old_gateway}" dev "${interface}" \
+            proto dhcp 2>/dev/null || true
+    fi
+}
+
+case "${reason:-}" in
+    BOUND|RENEW|REBIND|REBOOT|TIMEOUT)
+        case "${interface:-}" in
+            Vlan*)
+                if ! ztp_vlan_route_lease_usable; then
+                    ztp_vlan_route_delete
+                elif [ -n "${new_dhcp_server_identifier:-}" ] && \
+                     [ -n "${new_routers:-}" ]; then
+                    ztp_vlan_route_server=${new_dhcp_server_identifier%% *}
+                    ztp_vlan_route_gateway=${new_routers%% *}
+
+                    if [ "${old_dhcp_server_identifier:-}" != "${new_dhcp_server_identifier:-}" ] || \
+                       [ "${old_routers:-}" != "${new_routers:-}" ]; then
+                        ztp_vlan_route_delete
+                    fi
+
+                    if ! ip route replace "${ztp_vlan_route_server}/32" \
+                        via "${ztp_vlan_route_gateway}" dev "${interface}" \
+                        proto dhcp; then
+                        logger -t sonic-ztp \
+                            "Failed to install DHCP server route ${ztp_vlan_route_server}/32 via ${ztp_vlan_route_gateway} dev ${interface}"
+                    fi
+                fi
+                ;;
+        esac
+        ;;
+    EXPIRE|FAIL|RELEASE|STOP)
+        case "${interface:-}" in
+            Vlan*) ztp_vlan_route_delete ;;
+        esac
+        ;;
+esac
+
+:
