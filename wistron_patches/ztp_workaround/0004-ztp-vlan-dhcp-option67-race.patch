+clear_published_dhcp_data() {
+    rm -f "$PROVISIONING_SCRIPT_URL_FILE"
+    rm -f "$ZTP_JSON_URL_FILE"
+    rm -f "$ZTP_TFTP_SERVER_FILE"
+    rm -f "$GRAPH_URL"
+    rm -f "$ACL_URL"
+}
+
+publish_candidate_file() {
+    candidate_file=$1
+    published_file=$2
+
+    if [ -s "$candidate_file" ]; then
+        candidate_value=$(cat "$candidate_file")
+        atomic_write "$published_file" "$candidate_value"
+    fi
+}
+
+install_candidate_route() {
+    candidate_interface=$1
+    candidate_path="${DHCP_CANDIDATE_DIR}/${candidate_interface}"
+
+    case "$candidate_interface" in
+        Vlan[0-9]*) ;;
+        *) return 0 ;;
+    esac
+
+    [ -s "${candidate_path}/dhcp-server" ] || return 0
+    [ -s "${candidate_path}/router" ] || return 0
+
+    candidate_server=$(cat "${candidate_path}/dhcp-server")
+    candidate_router=$(cat "${candidate_path}/router")
