+        return 1
+    fi
+}
+
+delete_candidate_route() {
+    candidate_interface=$1
+    candidate_path="${DHCP_CANDIDATE_DIR}/${candidate_interface}"
+
+    case "$candidate_interface" in
+        Vlan[0-9]*) ;;
+        *) return 0 ;;
+    esac
+
+    [ -s "${candidate_path}/dhcp-server" ] || return 0
+    [ -s "${candidate_path}/router" ] || return 0
+
+    candidate_server=$(cat "${candidate_path}/dhcp-server")
+    candidate_router=$(cat "${candidate_path}/router")
+    ip route del "${candidate_server}/32" via "$candidate_router" \
+        dev "$candidate_interface" proto dhcp 2>/dev/null || true
+}
+
+publish_dhcp_candidate() {
+    candidate_interface=$1
+    candidate_path="${DHCP_CANDIDATE_DIR}/${candidate_interface}"
+
+    candidate_has_data "$candidate_path" || return 1
+    install_candidate_route "$candidate_interface" || return 1
+
+    clear_published_dhcp_data
+    mkdir -p "$LOCK_DIR" || return 1
+    atomic_write "$LOCK_ID_FILE" "dhcp:${candidate_interface}" || return 1
+
+    # Publish ancillary data before the primary discovery URLs. The route hook
+    # is ordered before this hook by run-parts, so a visible URL is reachable.
+    publish_candidate_file "${candidate_path}/tftp-server" "$ZTP_TFTP_SERVER_FILE"
+    publish_candidate_file "${candidate_path}/acl-url" "$ACL_URL"
+    publish_candidate_file "${candidate_path}/ztp-json-url" "$ZTP_JSON_URL_FILE"
+    publish_candidate_file "${candidate_path}/provisioning-script-url" "$PROVISIONING_SCRIPT_URL_FILE"
+    publish_candidate_file "${candidate_path}/graph-url" "$GRAPH_URL"
+}
+
+select_dhcp_candidate() {
+    # Prefer a VLAN lease over eth0/front-panel leases. The Wistron workaround
+    # deliberately starts DHCP on Vlan interfaces after in-band connectivity is
+    # available.
+    for candidate_path in "${DHCP_CANDIDATE_DIR}"/Vlan*; do
+        [ -d "$candidate_path" ] || continue
+        candidate_has_data "$candidate_path" || continue
+        basename "$candidate_path"
+        return 0
+    done
+
+    for candidate_path in "${DHCP_CANDIDATE_DIR}"/*; do
+        [ -d "$candidate_path" ] || continue
+        case "$(basename "$candidate_path")" in
+            Vlan*) continue ;;
+        esac
+        candidate_has_data "$candidate_path" || continue
+        basename "$candidate_path"
+        return 0
+    done
+
+    return 1
+}
+
+promote_dhcp_candidate() {
+    candidate_interface=$(select_dhcp_candidate) || return 1
+    publish_dhcp_candidate "$candidate_interface"
+}
+
+cleanup_dhcp_candidate() {
+    valid_dhcp_interface || return 0
+
+    delete_candidate_route "$interface"
+    rm -rf "${DHCP_CANDIDATE_DIR}/${interface}"
+
+    if [ "$(read_lock)" != "dhcp:${interface}" ]; then
+        return 0
+    fi
+
+    if ! promote_dhcp_candidate; then
+        clear_published_dhcp_data
+        give_lock dhcp
+    fi
+}
+
+process_dhcp_success() {
+    if [ "$reason" = "TIMEOUT" ] && ! dhcp_lease_is_usable; then
+        cleanup_dhcp_candidate
+        return 0
+    fi
+
+    update_dhcp_candidate || return 0
+
+    current_owner=$(read_lock)
+    if [ -z "$current_owner" ] || [ "$current_owner" = "dhcp:${interface}" ]; then
+        publish_dhcp_candidate "$interface"
+        return
+    fi
+
+    # A valid VLAN lease supersedes an eth0/Ethernet owner. Later STOP/RELEASE
+    # events from the old owner cannot delete the VLAN candidate.
+    case "$interface:$current_owner" in
+        Vlan*:dhcp:*) publish_dhcp_candidate "$interface" ;;
+    esac
+}
