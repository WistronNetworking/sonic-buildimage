+#!/usr/bin/env python3:
+
+import os
+import sys
+import click
+import subprocess
+import sonic_platform
+import sonic_platform_base.sonic_sfp.sfputilhelper
+import time
+import shutil
+
+from sonic_platform_base.sfp_base import SfpBase
+from sonic_py_common import device_info, logger, multi_asic
+from swsscommon.swsscommon import ConfigDBConnector
+from utilities_common.netstat import ns_diff, table_as_json, format_brate, format_prate, format_util, format_number_with_comma
+from tabulate import tabulate
+from utilities_common.intf_filter import parse_interface_in_filter
+import re
+
+SYSLOG_IDENTIFIER = "poeutil"
+
+EXIT_FAIL = -1
+EXIT_SUCCESS = 0
+ERROR_PERMISSIONS = 1
+ERROR_CHASSIS_LOAD = 2
+ERROR_SFPUTILHELPER_LOAD = 3
+ERROR_PORT_CONFIG_LOAD = 4
+ERROR_NOT_IMPLEMENTED = 5
+ERROR_INVALID_PORT = 6
+SMBUS_BLOCK_WRITE_SIZE = 32
+
+# Global platform-specific Chassis class instance
+platform_chassis = None
+
+# Global platform-specific sfputil class instance
+platform_sfputil = None
+
+# Global platform poe object instance
+platform_chassis_poe = None
+
+# Global logger instance
+log = logger.Logger(SYSLOG_IDENTIFIER)
+
+def atoi(text):
+    return int(text) if text.isdigit() else text
+
+def natural_keys(text):
+    '''
+    alist.sort(key=natural_keys) sorts in human order
+    http://nedbatchelder.com/blog/200712/human_sorting.html
+    (See Toothy's implementation in the comments)
+    '''
+    return [ atoi(c) for c in re.split(r'(\d+)', text) ]
+
+def is_port_type_poe(poe_class):
+    if (poe_class == "NA"):
+        return False
+    else:
+        return True
+
+
+# Instantiate platform-specific Chassis class
+def load_platform_chassis():
+    global platform_chassis
+
+    # Load new platform api class
+    try:
+        platform_chassis = sonic_platform.platform.Platform().get_chassis()
+    except Exception as e:
+        log.log_error(
+            "Failed to instantiate Chassis due to {}".format(repr(e)))
+
+    if not platform_chassis:
+        return False
+
+    return True
+
+
+# Instantiate SfpUtilHelper class
+def load_sfputilhelper():
+    global platform_sfputil
+
+    # we have to make use of sfputil for some features
+    # even though when new platform api is used for all vendors.
+    # in this sense, we treat it as a part of new platform api.
+    # we have already moved sfputil to sonic_platform_base
+    # which is the root of new platform api.
+    platform_sfputil = sonic_platform_base.sonic_sfp.sfputilhelper.SfpUtilHelper()
+
+    if not platform_sfputil:
+        return False
+
+    return True
+
+
+def load_port_config():
+    try:
+        if multi_asic.is_multi_asic():
+            # For multi ASIC platforms we pass DIR of port_config_file_path and the number of asics
+            (platform_path, hwsku_path) = device_info.get_paths_to_platform_and_hwsku_dirs()
+
+            # Load platform module from source
+            platform_sfputil.read_all_porttab_mappings(
+                hwsku_path, multi_asic.get_num_asics())
+        else:
+            # For single ASIC platforms we pass port_config_file_path and the asic_inst as 0
+            port_config_file_path = device_info.get_path_to_port_config_file()
+            platform_sfputil.read_porttab_mappings(port_config_file_path, 0)
+    except Exception as e:
+        log.log_error("Error reading port info ({})".format(str(e)), True)
+        return False
+
+    return True
+
+def load_chassis_poe():
+    global platform_chassis_poe
+
+    # Load platform poe
+    try:
+        platform_chassis_poe = platform_chassis.get_poe()
+    except Exception as e:
+        log.log_error(
+            "Failed to instantiate Chassis poe due to {}".format(repr(e)))
+
+    if not platform_chassis_poe:
+        return False
+
+    return True
+
+def get_physical_port_name(logical_port, physical_port, ganged):
+    """
+        Returns:
+          port_num if physical
+          logical_port:port_num if logical port and is a ganged port
+          logical_port if logical and not ganged
+    """
+    if logical_port == physical_port:
+        return str(logical_port)
+    elif ganged:
+        return "{}:{} (ganged)".format(logical_port, physical_port)
+    else:
+        return logical_port
+
+
+def logical_port_name_to_physical_port_list(port_name):
+    if port_name.startswith("Ethernet"):
+        if platform_sfputil.is_logical_port(port_name):
+            return platform_sfputil.get_logical_to_physical(port_name)
+        else:
+            click.echo("Error: Invalid port '{}'".format(port_name))
+            return None
+    else:
+        return [int(port_name)]
+
+
+def print_all_valid_port_values():
+    click.echo("Valid values for port: {}\n".format(
+        str(platform_sfputil.logical)))
+
+
+def run_lldpcli_config_port_command(interface, enabled):
+    # lldpcli configure port Etherent40 dot3 power pse supported enabled powerpairs signal class class-4 type 2  source primary priority low requested 28000 allocated 15000
+
+    cmd = "lldpcli configure port %s dot3 power pse supported %s powerpairs signal class class-4" % (
+        interface, enabled)
+    # print(cmd)
+    try:
+        result = subprocess.check_output(
+            cmd, shell=True, stderr=subprocess.STDOUT, universal_newlines=True)
+        # print(result.strip())
+        return result.strip()
+    except subprocess.CalledProcessError as e:
+        click.echo("Error running run_lldpcli_neighbor_command command:", e)
+        return None
+
+
+# This is our main entrypoint - the main 'poeutil' command
+@click.group()
+def cli():
+    """poeutil - Command line utility for managing PoE devices"""
+
+    # Load platform-specific Chassis class
+    if not load_platform_chassis():
+        sys.exit(ERROR_CHASSIS_LOAD)
+
+    # Load SfpUtilHelper class
+    if not load_sfputilhelper():
+        sys.exit(ERROR_SFPUTILHELPER_LOAD)
+
+    # Load port info
+    if not load_port_config():
+        sys.exit(ERROR_PORT_CONFIG_LOAD)
+
+    # Load port info
+    if not load_chassis_poe():
+        sys.exit(ERROR_NOT_IMPLEMENTED)
+
+
+# 'save_conf' subcommand
+@cli.command()
+def save_conf():
+    """ Save PoE Configure"""
+    # As the PoE configuration database is designed as part of port configuration
+    # in cnfig_db.json, we just save the configuration in the PoE controller and
+    # the PoE global configurationhere
+
+    # click.echo("Save PoE configuartion ... ", nl=False)
+    platform_chassis_poe.save_config()
+
+
+@cli.command()
+@click.argument('state', metavar='<enable|disable>', required=True, type=click.Choice(['enable', 'disable']))
+def preemptive_priority(state):
+    """Configure the PoE priority ignorance"""
+
+    click.echo("{} PoE preemptive priority  ... ".format(
+        "Enabling" if state == 'enable' else "Disabling"), nl=False)
+
+    result = platform_chassis_poe.set_preemptive_priority(state)
+
+    if result:
+        config_db = ConfigDBConnector()
+        config_db.connect()
+        config_db.mod_entry("POE", 'Global', {'preemptive_priority': state})
+        click.echo("OK")
+    else:
+        click.echo("Failed")
+
+
+@cli.command()
+@click.argument('state', metavar='<enable|disable>', required=True, type=click.Choice(['enable', 'disable']))
+def power_redundant(state):
+    """Configure the PoE power redundant"""
+
+    click.echo("{} PoE power redundance  ... ".format(
+        "Enabling" if state == 'enable' else "Disabling"), nl=False)
+
+    result = platform_chassis_poe.set_power_redundant(state)
+
+    if result:
+        config_db = ConfigDBConnector()
+        config_db.connect()
+        config_db.mod_entry("POE", 'Global', {'power_redundant': state})
+        click.echo("OK")
+    else:
+        click.echo("Failed")
+
+
+@ cli.command()
+@ click.argument('port_name', metavar='<port_name>')
+@ click.argument('state', metavar='<enable|disable>', required=True, type=click.Choice(['enable', 'disable']))
+def mdi_tlv(port_name, state):
+    """Configure the LLDP of PoE Ports"""
+    ganged = False
+    i = 1
+
+    if platform_sfputil.is_logical_port(port_name) == 0:
+        click.echo("Error: invalid port '{}'\n".format(port_name))
+        print_all_valid_port_values()
+        sys.exit(ERROR_INVALID_PORT)
+
+    physical_port_list = logical_port_name_to_physical_port_list(port_name)
+    if physical_port_list is None:
+        click.echo(
+            "Error: No physical ports found for logical port '{}'".format(port_name))
+        return
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+    poe_port = config_db.get_entry('POE', port_name)
+
+    if not is_port_type_poe(poe_port['class']):
+        click.echo(
+            "LLDP MDI-TLV is not applicable for none-PoE port {}.".format(port_name))
+        sys.exit(EXIT_FAIL)
+
+    if len(physical_port_list) > 1:
+        ganged = True
+
+    for physical_port in physical_port_list:
+        click.echo("{} LLDP MDI-TLV for port {} ... ".format("Enabling" if state == 'enable' else "Disabling",
+                                                             get_physical_port_name(port_name, i, ganged)), nl=False)
+
+        # Update lldpd dot3 status
+        if (state == 'enable'):
+            enabled = 'enabled'
+        else:
+            enabled = ''
+        run_lldpcli_config_port_command(port_name, enabled)
+
+        # Save to DB
+        config_db.mod_entry("POE", port_name, {'lldp': state})
+        click.echo("OK")
+
+        i += 1
+
+
+@ cli.command()
+@ click.argument('port_name', metavar='<port_name>')
+@ click.argument('priority', metavar='<critical|high|low>', required=True, type=click.Choice(['critical', 'high', 'low']))
+def port_priority(port_name, priority):
+    """Configure the priority of PoE Ports"""
+    ganged = False
+    i = 1
+
+    if platform_sfputil.is_logical_port(port_name) == 0:
+        click.echo("Error: invalid port '{}'\n".format(port_name))
+        print_all_valid_port_values()
+        sys.exit(ERROR_INVALID_PORT)
+
+    physical_port_list = logical_port_name_to_physical_port_list(port_name)
+    # click.echo("physical_port_list '{}'\n".format(physical_port_list))
+    if physical_port_list is None:
+        click.echo(
+            "Error: No physical ports found for logical port '{}'".format(port_name))
+        return
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+    poe_port = config_db.get_entry('POE', port_name)
+
+    if not is_port_type_poe(poe_port['class']):
+        click.echo(
+            "PoE priority is not applicable for none-PoE port {}.".format(port_name))
+        sys.exit(EXIT_FAIL)
+
+    if len(physical_port_list) > 1:
+        ganged = True
+
+    for physical_port in physical_port_list:
+        click.echo("Set port priority for port {} ... ".format(
+            get_physical_port_name(port_name, i, ganged)), nl=False)
+
+        poe_port = config_db.get_entry('POE', port_name)
+
+        result = platform_chassis_poe.set_port_priority(int(poe_port['lanes']), priority)
+
+        if result:
+            config_db.mod_entry("POE", port_name, {'priority': priority})
+            click.echo("OK")
+        else:
+            click.echo("Failed")
+
+        i += 1
+
+
+@ cli.command()
