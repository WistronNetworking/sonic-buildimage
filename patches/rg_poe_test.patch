+def get_priority_value(priority):  # James
+    priority_mapping = {
+        "critical": "1",
+        "high": "2",
+        "low": "3",
+        "0xff": "0xff"  # 0xff means don't change the setting
+    }
+    return priority_mapping.get(priority, None)
