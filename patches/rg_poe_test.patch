+@ poe.command()
+@ click.pass_context
+@ click.argument('interface_name', metavar='<interface_name>', required=True)
+@ click.argument('power_mode', metavar='<enable|disable>', required=True, type=click.Choice(['enable', 'disable']))
+@ click.argument('max_power_float', metavar='<max_power_float>', required=True, type=click.FloatRange(0, 90))
+def power_inline(ctx, interface_name, power_mode, max_power_float):
+    """Config interface PoE power"""
+    # Get the config_db connector
+    config_db = ctx.obj['config_db']
+    port_dict = config_db.get_table('PORT')
+
+    if clicommon.get_interface_naming_mode() == "alias":
+        interface_name = interface_alias_to_name(config_db, interface_name)
+        if interface_name is None:
+            ctx.fail("'interface_name' is None!")
+
+    intf_fs = parse_interface_in_filter(interface_name)
+    if len(intf_fs) > 1 and multi_asic.is_multi_asic():
+        ctx.fail("Interface range not supported in multi-asic platforms !!")
+
+    if len(intf_fs) == 1 and interface_name_is_valid(config_db, interface_name) is False:
+        ctx.fail("Interface name is invalid. Please enter a valid interface name!!")
+
+    # power_mode options
+    # 0 - disable with dynamic power calculation (0b00)
+    # 1 - enable with dynamic power calculation  (0b01)
+    # 2 - disable with static power calculation  (0b10)
+    # 3 - enable with static power calculation   (0b11)
+
+    # bit 2 is power_calculation mode
+    # dynamic mode : bit2 is 0
+    # static mode : bit 2 is 1
+    power_calculation = "static" if (port_dict[interface_name]["poe_status"] == "disableStatic" or
+                         port_dict[interface_name]["poe_status"] == "enableStatic" or
+                         port_dict[interface_name]["poe_status"] == "disable") else "dynamic"
+
+    if power_calculation == "static": # static
+        if power_mode == "enable":
+            power_mode_p = "enableStatic"
+        else:
+            power_mode_p = "disableStatic"
+    else:
+        if power_mode == "enable":
+            power_mode_p = "enableDynamic"
+        else:
+            power_mode_p = "disableDynamic"
+
+    power_inline_p(ctx, interface_name, power_mode_p, max_power_float)
+
+@ poe.command()
