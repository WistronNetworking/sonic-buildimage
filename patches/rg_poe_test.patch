+
+    table = []
+    header = ["Interface", "Method"]
+
+    for key in sorted(poe_dict, key=natural_keys):
+        if key == 'Global': #Global setting
+            continue  # Skips
+        if poe_dict[key]["priority"] == "NA":
+            continue  # Skips the non-poe ports
+
+        if port is not None and key != port:
