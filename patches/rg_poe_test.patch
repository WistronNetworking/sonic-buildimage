+    if physical_port_list is None:
+        click.echo(
+            "Error: No physical ports found for logical port '{}'".format(port_name))
+        return
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+    poe_port = config_db.get_entry('POE', port_name)
+
+    if not is_port_type_poe(poe_port['class']):
+        click.echo(
+            "power-inline is not applicable for none-PoE port {}.".format(port_name))
+        sys.exit(EXIT_FAIL)
+
+    if len(physical_port_list) > 1:
+        ganged = True
+
+    for physical_port in physical_port_list:
+        click.echo("Set port mode and max power for port {} ... ".format(
+            get_physical_port_name(port_name, i, ganged)), nl=False)
+
+        poe_port = config_db.get_entry('POE', port_name)
+        result = platform_chassis_poe.set_port_power(int(poe_port['lanes']), poe_port['class'], power_mode, float(max_power)/10)
+
+        if result:
+            config_db.mod_entry("POE", port_name, {'power_mode': power_mode})
+            config_db.mod_entry("POE", port_name, {
+                               'maxpower': float(max_power/10)})
+            click.echo("OK")
+        else:
+            click.echo("Failed")
+
+        i += 1
+
+# 'show' subgroup
+@ cli.group()
+def show():
+    """Display status of PoE Ports"""
+    pass
+
+# 'power_inline' subcommand
+
+
+@ show.command()
+@ click.option('-p', '--port', metavar='<port_name>', help="Display PoE port status for port <port_name> only")
+def power_inline(port):
+    """Display power-inline status of PoE port(s)"""
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+    poe_dict = config_db.get_table('POE')
+
+    table = []
+    header = ["Interface", "Mode", "Max-power(W)",
+              "Priority", "State", "Used(W)"]
+    # print(port_dict)
+
+    for key in sorted(poe_dict, key=natural_keys):
+        if key == 'Global': #Global setting
+            continue  # Skips
+        #
+        if poe_dict[key]["priority"] == "NA":
+            continue  # Skips the non-poe ports
+
+        if port is not None and key != port:
+            continue  # Skips the non-selected ports
+
+        max_power = poe_dict[key]["maxpower"]
+        if float(max_power) == 0.0:
+            max_power = "auto"
+
+        ps_info = platform_chassis_poe.get_port_status(int(poe_dict[key]['lanes']))
+
+        table.append((key, poe_dict[key]["power_mode"], max_power,
+                     poe_dict[key]["priority"], ps_info['portstatus'], ps_info['measuredPortPower']))
+
+    print(tabulate(table, header, tablefmt='simple', stralign='left'))
+
+
+@ show.command()
