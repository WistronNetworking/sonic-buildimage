+def parse_data(data):
+    lines = data.strip().split('\n')
+    parsed_data = {}
+    for line in lines:
+        parts = line.strip().split()
+        if len(parts) >= 2:
+            key = parts[0]
+            value = " ".join(parts[1:])
+            parsed_data[key] = value
+    return parsed_data
