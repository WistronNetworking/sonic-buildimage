+
+        lldp_pse_info = platform_chassis_poe.get_port_lldp_pse_data(int(poe_dict[key]['lanes']))
+        table.append((key, lldp_pse_info['layer2Usage']))
+
+    print(tabulate(table, header, tablefmt='simple', stralign='left'))
+
+
+@ show.command()
+@ click.option('-p', '--port', metavar='<port_name>', help="Display PoE port status for port <port_name> only")
+def power_conf(port):
+    """Display power-inline status of PoE port(s)"""
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+    poe_dict = config_db.get_table('POE')
+
+    table = []
+    header = ["Interface", "Mode", "Max-power(W)",
+              "Priority", "MDI-TLV"]
+
+    for key in sorted(poe_dict, key=natural_keys):
+        if key == 'Global': #Global setting
+            continue  # Skips
+        if poe_dict[key]["priority"] == "NA":
+            continue  # Skips the non-poe ports
+
+        if port is not None and key != port:
+            continue  # Skips the non-selected ports
+
+        max_power = poe_dict[key]["maxpower"]
+        if float(max_power) == 0.0:
+            max_power = "auto"
+
+        table.append((key, poe_dict[key]["power_mode"], max_power,
+                     poe_dict[key]["priority"], poe_dict[key]["lldp"]))
+
+    print(tabulate(table, header, tablefmt='simple', stralign='left'))
+
+
+# 'system_power' subcommand
+@ show.command()
+def system_power():
+    """Display system-power status of PoE"""
+
+    total_power_info_dict = platform_chassis_poe.get_total_power()
+
+    header = ['name', 'power(W)']
+    table = []
+
+    display_word = "Power Consumption"
+    table.append((display_word, total_power_info_dict['powerconsumption']))
+
+    display_word = "Calculated Power"
+    table.append((display_word, total_power_info_dict['calcpower']))
+
+    display_word = "Available Power"
+    table.append((display_word, total_power_info_dict['availablepower']))
+
+    display_word = "Power Limit"
+    table.append((display_word, total_power_info_dict['powerlimit']))
+
+    display_word = "Power Bank"
+    table.append((display_word, hex(int(total_power_info_dict['powerbank']))))
+
+    config_db = ConfigDBConnector()
+    config_db.connect()
+
+    poe_global = config_db.get_entry('POE', 'Global')
+    value = poe_global['preemptive_priority']
+    display_word = "Preemptive Priority"
+    table.append((display_word, value))
+
+    value = poe_global['power_redundant']
+    display_word = "Power Redundance"
+    table.append((display_word, value))
+
+    click.echo(tabulate(table, header, tablefmt='simple', stralign='left'))
+
+
+if __name__ == '__main__':
+    cli()
