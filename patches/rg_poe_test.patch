+
+    if len(intf_fs) == 1 and interface_name_is_valid(config_db, interface_name) is False:
+        ctx.fail("Interface name is invalid. Please enter a valid interface name!!")
+
+    # power_mode options
+    # 0 - disable with dynamic power calculation (0b00)
+    # 1 - enable with dynamic power calculation  (0b01)
+    # 2 - disable with static power calculation  (0b10)
+    # 3 - enable with static power calculation   (0b11)
+
+    # bit 1 is power_status mode
+    # disable mode : bit 1 is 0
+    # enable mode : bit 1  is 1
+    power_status = "enable" if (poe_dict[interface_name]["power_mode"] == "enableDynamic" or
+                         poe_dict[interface_name]["power_mode"] == "enableStatic" or
+                         poe_dict[interface_name]["power_mode"] == "enable") else "disable"
+    #print(port_dict[interface_name]["poe_status"])
+    #print("power_status:", power_status)
+    if power_status == "enable": # enable
+        if power_calculation == "static":
+            power_mode_p = "enableStatic"
+        else:
+            power_mode_p = "enableDynamic"
+    else:
+        if power_calculation == "dynamic":
+            power_mode_p = "disableDynamic"
+        else:
+            power_mode_p = "disableStatic"
+
+    max_power = poe_dict[interface_name]["maxpower"]
+
+    power_inline_p(ctx, interface_name, power_mode_p, max_power)
